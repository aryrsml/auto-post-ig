# Instagram Graph API (Business/Creator + FB Page)
IG_USER_ID=
IG_ACCESS_TOKEN=
# Vercel Blob - buat di Vercel Dashboard > Storage > Blob > Create
BLOB_READ_WRITE_TOKEN=
# Proteksi endpoint cron/manual (random string)
CRON_SECRET=
# Opsional: custom hashtag caption
CAPTION_HASHTAGS=#Hadis #HadisHarian #HaditsNabi #Sunnah #Islam #Muslim
# Opsional: hashtag khusus doa (fallback ke CAPTION_HASHTAGS kalau kosong)
CAPTION_HASHTAGS_DOA=#Doa #DoaHarian #DoaMustajab #Dzikir #Islam #Muslim
# Opsional: base URL myQuran v3 (hadis) & v2 (doa)
MYQURAN_BASE_URL=https://api.myquran.com/v3
MYQURAN_V2_BASE_URL=https://api.myquran.com/v2
# Opsional: max panjang hadis (karakter), default 180
MAX_HADIS_LEN=300
# Opsional: max panjang artinya doa (karakter), fallback ke MAX_HADIS_LEN, default 300
MAX_DOA_LEN=300
# Opsional: max teks yang muat di gambar, sisanya lanjut ke caption, default 180
IMAGE_MAX_LEN=180
# Opsional: IG Graph version
IG_GRAPH_VERSION=v20.0
